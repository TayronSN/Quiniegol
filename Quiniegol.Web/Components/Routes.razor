<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">

    <Found Context="routeData">

        <!-- Muestra el componente correspondiente a la ruta encontrada y utiliza MainLayout como diseño general de las páginas. -->
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />

        <!-- Después de cambiar de página, coloca el foco en el primer <h1> de la nueva página, facilitando la navegación. -->
        <FocusOnNavigate RouteData="routeData" Selector="h1" />

    </Found>

</Router>