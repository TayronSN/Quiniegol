@using Quiniegol.Core.Utils

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @if (Sesion.EsAdmin)
        {
            <!-- El administrador es dirigido a su página principal. -->
            <a class="navbar-brand" href="/principal">
                Quiniegol
            </a>
        }
        else
        {
            <!-- El usuario normal es dirigido a su página principal. -->
            <a class="navbar-brand" href="/principal-usuario">
                Quiniegol
            </a>
        }
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <!-- Opciones disponibles exclusivamente para administradores. -->
        @if (Sesion.EsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link"
                         href="/principal">
                    Principal
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link"
                         href="/partidos">
                    Partidos
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link"
                         href="/usuarios">
                    Usuarios
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link"
                         href="/pronosticos">
                    Pronósticos
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link"
                         href="/ranking">
                    Ranking
                </NavLink>
            </div>
        }

        <!-- Opciones disponibles para usuarios normales. -->
        else if (Sesion.EsUser)
        {
        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="/principal-usuario">
                Principal
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="/pronosticos">
                Pronósticos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="/ranking">
                Ranking
            </NavLink>
        </div>
        }

        <!-- Solo muestra la opción de cerrar sesión cuando existe una sesión activa. -->
        @if (Sesion.InicioSesion)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link"
                         href="/logout">
                    Cerrar sesión
                </NavLink>
            </div>
        }

    </nav>
</div>