@page "/partidos"
@rendermode InteractiveServer

@using Quiniegol.Core.Models
@using Quiniegol.Core.Data
@using Quiniegol.Core.Controllers
@using Quiniegol.Core.Utils

@inject IJSRuntime JS

<h3>Partidos</h3>

@if (!Sesion.InicioSesion)
{
    <p>Sesion no iniciada.</p>
}
else if (!Sesion.EsAdmin)
{
    <p>No tiene permisos para acceder a esta página.</p>
}
else
{
    <h4>Partidos registrados</h4>

    @if (partidos.Count == 0)
    {
        <p>No hay partidos registrados.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Local</th>
                    <th>Visitante</th>
                    <th>Fase</th>
                    <th>Estado</th>
                    <th>Resultado</th>
                </tr>
            </thead>

            <tbody>
                @foreach (Partido partido in partidos)
                {
                    Equipo? equipoLocal = EquiposData.BuscarPorId(partido.IdEquipoLocal);

                    Equipo? equipoVisitante = EquiposData.BuscarPorId(partido.IdEquipoVisitante);

                    <tr>
                        <td>@partido.IdPartido</td>
                        <td>@equipoLocal?.Nombre</td>
                        <td>@equipoVisitante?.Nombre</td>
                        <td>@partido.Fase</td>
                        <td>@partido.Estado</td>
                        <td>@partido.Resultado</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <br />

    <h4>Registrar partido</h4>

    <div>
        <label>Equipo local</label>

        <select @bind="nuevoPartido.IdEquipoLocal">
            <option value="0">Seleccione un equipo</option>

            @foreach (Equipo equipo in equipos)
            {
                <option value="@equipo.IdEquipo">
                    @equipo.Nombre
                </option>
            }
        </select>
    </div>

    <br />

    <div>
        <label>Equipo visitante</label>

        <select @bind="nuevoPartido.IdEquipoVisitante">
            <option value="0">Seleccione un equipo</option>

            @foreach (Equipo equipo in equipos)
            {
                <option value="@equipo.IdEquipo">
                    @equipo.Nombre
                </option>
            }
        </select>
    </div>

    <br />

    <div>
        <label>Fase</label>

        <select @bind="nuevoPartido.Fase">
            <option value="">Seleccione una fase</option>
            <option value="Grupos">Grupos</option>
        </select>
    </div>

    <br />

    <button @onclick="RegistrarPartido">
        Registrar partido
    </button>

    <br />

    <h4>Actualizar partido</h4>

    <div>
        <label>Partido</label>

        <select @bind="idPartidoActualizar">
            <option value="0">Seleccione un partido</option>

            @foreach (Partido partido in partidos)
            {
                Equipo? equipoLocal = EquiposData.BuscarPorId(partido.IdEquipoLocal);

                Equipo? equipoVisitante = EquiposData.BuscarPorId(partido.IdEquipoVisitante);

                <option value="@partido.IdPartido">
                    @equipoLocal?.Nombre vs @equipoVisitante?.Nombre
                </option>
            }
        </select>
    </div>

    <br />

    <div>
        <label>Resultado</label>

        <select @bind="resultadoSeleccionado">
            <option value="">Seleccione un resultado</option>
            <option value="Local">Local</option>
            <option value="Empate">Empate</option>
            <option value="Visitante">Visitante</option>
        </select>
    </div>

    <br />

    <button @onclick="ActualizarPartido">
        Actualizar partido
    </button>

    <br />

    <h4>Eliminar partido</h4>

    <div>
        <label>Partido</label>

        <select @bind="idPartidoEliminar">
            <option value="0">Seleccione un partido</option>

            @foreach (Partido partido in partidos)
            {
                Equipo? equipoLocal = EquiposData.BuscarPorId(partido.IdEquipoLocal);

                Equipo? equipoVisitante = EquiposData.BuscarPorId(partido.IdEquipoVisitante);

                <option value="@partido.IdPartido">
                    @equipoLocal?.Nombre vs @equipoVisitante?.Nombre
                </option>
            }
        </select>
    </div>

    <br />

    <button @onclick="EliminarPartido">
        Eliminar partido
    </button>

    <p>@mensaje</p>
}

@code {
    private List<Partido> partidos = new List<Partido>();

    private List<Equipo> equipos = new List<Equipo>();

    private Partido nuevoPartido = new Partido();

    // Se mantienen IDs separados para que actualizar y eliminar puedan seleccionar partidos de forma independiente
    private int idPartidoActualizar;

    private int idPartidoEliminar;

    private string resultadoSeleccionado = "";

    private string mensaje = "";

    protected override void OnInitialized()
    {
        // Se cargan los partidos y equipos al abrir la página
        partidos = PartidosData.LeerPartidos();

        equipos = EquiposData.LeerEquipos();
    }

    private void RegistrarPartido()
    {
        PartidoController partidoController = new PartidoController();

        // El controlador realiza las validaciones antes de guardar el partido
        string resultado = partidoController.RegistrarPartido(nuevoPartido);

        mensaje = resultado;

        if (resultado == "Partido registrado correctamente.")
        {
            // Se actualiza la lista para mostrar inmediatamente el nuevo partido
            partidos = PartidosData.LeerPartidos();

            // Se crea un nuevo objeto para limpiar los campos del formulario
            nuevoPartido = new Partido();
        }
    }

    private void ActualizarPartido()
    {
        // Se busca el partido seleccionado para modificarlo
        Partido? partido = PartidosData.BuscarPorId(idPartidoActualizar);

        if (partido == null)
        {
            mensaje = "Seleccione un partido";
            return;
        }

        partido.Resultado = resultadoSeleccionado;

        PartidoController partidoController = new PartidoController();

        // El controlador actualiza también el estado del partido si tiene o no un resultado
        string resultado = partidoController.ActualizarPartido(partido);

        mensaje = resultado;

        if (resultado == "Partido actualizado correctamente.")
        {
            partidos = PartidosData.LeerPartidos();

            // Limpia únicamente los campos utilizados para actualizar
            idPartidoActualizar = 0;

            resultadoSeleccionado = "";
        }
    }

    private async Task EliminarPartido()
    {
        // Se obtiene el partido seleccionado para eliminarlo
        Partido? partido = PartidosData.BuscarPorId(idPartidoEliminar);

        if (partido == null)
        {
            mensaje = "Seleccione un partido";
            return;
        }

        Equipo? equipoLocal = EquiposData.BuscarPorId(partido.IdEquipoLocal);

        Equipo? equipoVisitante = EquiposData.BuscarPorId(partido.IdEquipoVisitante);

        string nombrePartido = $"{equipoLocal?.Nombre} vs {equipoVisitante?.Nombre}";

        // Se solicita confirmación antes de eliminar el partido.
        bool confirmar = await JS.InvokeAsync<bool>( "confirm", $"¿Desea eliminar el partido {nombrePartido}?");

        if (!confirmar)
        {
            return;
        }

        PartidoController partidoController = new PartidoController();

        mensaje = partidoController.EliminarPartido(idPartidoEliminar);

        if (mensaje == "Partido eliminado correctamente.")
        {
            // Se actualiza la tabla después de eliminar el partido
            partidos = PartidosData.LeerPartidos();

            idPartidoEliminar = 0;
        }
    }
}