@page "/pronosticos"
@rendermode InteractiveServer

@using Quiniegol.Core.Models
@using Quiniegol.Core.Data
@using Quiniegol.Core.Controllers
@using Quiniegol.Core.Utils

<h3>Pronósticos</h3>

@if (!Sesion.InicioSesion)
{
    <p>Sesion no iniciada.</p>
}
else
{
    <h4>Realizar pronóstico</h4>

    @if (partidosAbiertos.Count == 0)
    {
        <p>No hay partidos abiertos para pronosticar.</p>
    }
    else
    {
        <div>
            <label>Partido</label>

            <select @bind="idPartidoSeleccionado"
                    @bind:after="ActualizarPartidoSeleccionado">

                <option value="0">
                    Seleccione un partido
                </option>

                @foreach (Partido partido in partidosAbiertos)
                {
                    Equipo? equipoLocal = EquiposData.BuscarPorId(partido.IdEquipoLocal);

                    Equipo? equipoVisitante = EquiposData.BuscarPorId(partido.IdEquipoVisitante);

                    <option value="@partido.IdPartido">
                        @equipoLocal?.Nombre vs @equipoVisitante?.Nombre
                    </option>
                }
            </select>
        </div>

        <br />

        @if (equipoLocalSeleccionado != null &&
             equipoVisitanteSeleccionado != null)
        {
            <div>
                <div>
                    <p>@equipoLocalSeleccionado.Nombre</p>

                    <img src="/@equipoLocalSeleccionado.Bandera"
                         alt="@equipoLocalSeleccionado.Nombre"
                         width="100" />
                </div>

                <div>
                    <p>@equipoVisitanteSeleccionado.Nombre</p>

                    <img src="/@equipoVisitanteSeleccionado.Bandera"
                         alt="@equipoVisitanteSeleccionado.Nombre"
                         width="100" />
                </div>
            </div>

            <br />

            <div>
                <label>Resultado</label>

                <br />

                <input type="radio"
                       name="resultado"
                       checked="@(resultadoSeleccionado == "Local")"
                       @onclick='() => resultadoSeleccionado = "Local"' />

                <label>
                    @equipoLocalSeleccionado.Nombre
                </label>

                <br />

                <input type="radio"
                       name="resultado"
                       checked="@(resultadoSeleccionado == "Empate")"
                       @onclick='() => resultadoSeleccionado = "Empate"' />

                <label>
                    Empate
                </label>

                <br />

                <input type="radio"
                       name="resultado"
                       checked="@(resultadoSeleccionado == "Visitante")"
                       @onclick='() => resultadoSeleccionado = "Visitante"' />

                <label>
                    @equipoVisitanteSeleccionado.Nombre
                </label>
            </div>

            <br />
        }

        <button @onclick="GuardarPronostico">
            Guardar
        </button>
    }

    <p>@mensaje</p>

    <br />

    <h4>Mis pronósticos</h4>

    @if (pronosticos.Count == 0)
    {
        <p>No tiene pronósticos registrados.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Partido</th>
                    <th>Pronóstico</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>
                @foreach (Pronostico pronostico in pronosticos)
                {
                    Partido? partido = PartidosData.BuscarPorId(pronostico.IdPartido);

                    if (partido == null)
                    {
                        continue;
                    }

                    Equipo? equipoLocal = EquiposData.BuscarPorId(partido.IdEquipoLocal);

                    Equipo? equipoVisitante = EquiposData.BuscarPorId(partido.IdEquipoVisitante);

                    if (equipoLocal == null ||
                        equipoVisitante == null)
                    {
                        continue;
                    }

                    <tr>
                        <td>
                            @equipoLocal.Nombre vs @equipoVisitante.Nombre
                        </td>

                        <td>
                            @pronostico.ResultadoPronosticado
                        </td>

                        <td>
                            @partido.Estado
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<Partido> partidosAbiertos = new List<Partido>();

    private List<Pronostico> pronosticos = new List<Pronostico>();

    private int idPartidoSeleccionado = 0;

    private string resultadoSeleccionado = "";

    private string mensaje = "";

    private Equipo? equipoLocalSeleccionado;

    private Equipo? equipoVisitanteSeleccionado;

    private PronosticoController pronosticoController = new PronosticoController();

    protected override void OnInitialized()
    {
        // Al abrir la página se cargan los partidos disponibles y los pronósticos del usuario actual
        CargarPartidos();

        CargarPronosticos();
    }

    private void CargarPartidos()
    {
        partidosAbiertos = new List<Partido>();

        List<Partido> partidos = PartidosData.LeerPartidos();

        // Solo se agregan los partidos que todavía están abiertos para que puedan recibir pronósticos
        foreach (Partido partido in partidos)
        {
            if (partido.Estado == "Abierto")
            {
                partidosAbiertos.Add(partido);
            }
        }
    }

    private void CargarPronosticos()
    {
        pronosticos = new List<Pronostico>();

        if (Sesion.UsuarioActual == null)
        {
            return;
        }

        List<Pronostico> todosLosPronosticos = PronosticosData.LeerPronosticos();

        // Se filtran los pronósticos para mostrar únicamente los realizados por el usuario que tiene la sesión activa.
        foreach (Pronostico pronostico in todosLosPronosticos)
        {
            if (pronostico.IdEmpleado == Sesion.UsuarioActual.IdEmpleado)
            {
                pronosticos.Add(pronostico);
            }
        }
    }

    private void ActualizarPartidoSeleccionado()
    {
        // Primero se limpian los equipos mostrados anteriormente
        equipoLocalSeleccionado = null;

        equipoVisitanteSeleccionado = null;

        if (idPartidoSeleccionado == 0)
        {
            return;
        }

        Partido? partido = PartidosData.BuscarPorId(idPartidoSeleccionado);

        if (partido == null)
        {
            return;
        }

        // Al seleccionar un partido se obtienen sus dos equipos para mostrar sus nombres y banderas.
        equipoLocalSeleccionado = EquiposData.BuscarPorId(partido.IdEquipoLocal);

        equipoVisitanteSeleccionado = EquiposData.BuscarPorId(partido.IdEquipoVisitante);
    }

    private void GuardarPronostico()
    {
        if (idPartidoSeleccionado == 0)
        {
            mensaje = "Debe seleccionar un partido.";
            return;
        }

        if (Sesion.UsuarioActual == null)
        {
            mensaje = "Sesion no iniciada.";
            return;
        }

        Pronostico pronostico = new Pronostico();

        // El empleado se obtiene directamente de la sesión actual
        pronostico.IdEmpleado = Sesion.UsuarioActual.IdEmpleado;

        pronostico.IdPartido = idPartidoSeleccionado;

        pronostico.ResultadoPronosticado = resultadoSeleccionado;

        // El controlador valida y guarda el pronóstico
        string resultado = pronosticoController.RegistrarPronostico(pronostico);

        mensaje = resultado;

        if (resultado == "Pronostico registrado correctamente.")
        {
            // Se actualiza la lista para mostrar inmediatamente el nuevo pronóstico.
            CargarPronosticos();

            // Se limpian los controles después de guardar.
            resultadoSeleccionado = "";

            idPartidoSeleccionado = 0;

            equipoLocalSeleccionado = null;

            equipoVisitanteSeleccionado = null;
        }
    }
}