@page "/ranking"
@rendermode InteractiveServer

@using Quiniegol.Core.Controllers
@using Quiniegol.Core.Data
@using Quiniegol.Core.Models
@using Quiniegol.Core.Utils

<h3>Ranking</h3>

@if (!Sesion.InicioSesion)
{
    <p>Debe iniciar sesión.</p>
}
else
{
    <h4>Ranking de jugadores</h4>

    @if (ranking.Count == 0)
    {
        <p>No hay jugadores con puntos todavía.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Posición</th>
                    <th>Jugador</th>
                    <th>Puntos</th>
                </tr>
            </thead>

            <tbody>
                @{
                    // Se utiliza para numerar las posiciones del ranking
                    int posicion = 1;
                }

                @foreach (Quiniegol.Core.Models.Ranking jugador in ranking)
                {
                    // Se busca el usuario para mostrar su nombre en lugar de solamente su ID de empleado
                    Usuario? usuario = UsuariosData.BuscarPorIdEmpleado(jugador.IdEmpleado);

                    // Si el usuario no existe, se utiliza el ID
                    string nombre = jugador.IdEmpleado;

                    if (usuario != null)
                    {
                        nombre =
                            usuario.Nombre + " " + usuario.Apellido;
                    }

                    <tr>
                        <td>@posicion</td>
                        <td>@nombre</td>
                        <td>@jugador.Puntos</td>
                    </tr>

                    posicion++;
                }
            </tbody>
        </table>

        <br />

        <a href="@ObtenerArchivoRanking()"
           download="Ranking.txt">
            Descargar Ranking
        </a>
    }
}

@code {
    private List<Quiniegol.Core.Models.Ranking> ranking = new List<Quiniegol.Core.Models.Ranking>();

    private RankingController rankingController = new RankingController();

    protected override void OnInitialized()
    {
        // Se genera el ranking al cargar la página.
        CargarRanking();
    }

    private void CargarRanking()
    {
        // El controlador calcula los puntos y devuelve los jugadores ordenados según su puntuación.
        ranking = rankingController.GenerarRanking();
    }

    private string ObtenerArchivoRanking()
    {
        List<string> lineas = new List<string>();

        lineas.Add("========== RANKING QUINIEGOL ==========");
        lineas.Add("");

        int posicion = 1;

        foreach (Quiniegol.Core.Models.Ranking jugador in ranking)
        {
            // Se obtiene el nombre del jugador a partir de su ID.
            Usuario? usuario = UsuariosData.BuscarPorIdEmpleado(jugador.IdEmpleado);

            // Si no se encuentra el usuario, se utiliza su ID.
            string nombre = jugador.IdEmpleado;

            if (usuario != null)
            {
                nombre = usuario.Nombre + " " + usuario.Apellido;
            }

            lineas.Add($"{posicion}. {nombre} - {jugador.Puntos} puntos");

            posicion++;
        }

        // Se unen todas las líneas para formar el contenido del archivo.
        string contenido = string.Join(Environment.NewLine, lineas);

        // Se convierte el texto en un enlace de descarga mediante un Data URI, evitando crear un archivo físico en el servidor.
        return "data:text/plain;charset=utf-8," + Uri.EscapeDataString(contenido);
    }
}