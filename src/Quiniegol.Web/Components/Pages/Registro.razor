@page "/registro"
@rendermode InteractiveServer

@using Quiniegol.Core.Controllers
@using Quiniegol.Core.Models

@inject NavigationManager Navigation

<h3>Registrar usuario</h3>

<div>
    <label>ID del empleado</label>
    <input @bind="idEmpleado" />
</div>

<div>
    <label>Nombre</label>
    <input @bind="nombre" />
</div>

<div>
    <label>Apellido</label>
    <input @bind="apellido" />
</div>

<div>
    <label>Departamento</label>

    <select @bind="departamento">
        <option value="">Seleccione un departamento</option>
        <option value="Finanzas">Finanzas</option>
        <option value="Recursos Humanos">Recursos Humanos</option>
        <option value="Tecnología">Tecnología</option>
        <option value="Facilities">Facilities</option>
        <option value="Seguridad">Seguridad</option>
        <option value="Call Center">Call Center</option>
    </select>
</div>

<div>
    <label>Correo</label>
    <input @bind="correo" />
</div>

<div>
    <label>Contraseña</label>
    <input type="password" @bind="password" />
</div>

<div>
    <label>Confirmar contraseña</label>
    <input type="password" @bind="confirmarPassword" />
</div>

<br />

<button @onclick="Registrar">
    Registrar usuario
</button>

<button @onclick="VolverLogin">
    Volver al login
</button>

<p>@mensaje</p>

@code {
    private string idEmpleado = "";
    private string nombre = "";
    private string apellido = "";
    private string departamento = "";
    private string correo = "";
    private string password = "";
    private string confirmarPassword = "";

    private string mensaje = "";

    private void Registrar()
    {
        // Se crea el objeto Usuario con los datos introducidos en el formulario
        Usuario usuario = new Usuario();

        usuario.IdEmpleado = idEmpleado;
        usuario.Nombre = nombre;
        usuario.Apellido = apellido;
        usuario.Departamento = departamento;
        usuario.Correo = correo;
        usuario.Password = password;

        // Todos los usuarios registrados desde el formulario se crean con el rol de usuario normal
        usuario.IdRol = 2;

        UsuarioController usuarioController = new UsuarioController();

        // El controlador realiza las validaciones y guarda el usuario si todos los datos son correctos
        mensaje = usuarioController.RegistrarUsuario(usuario, confirmarPassword);

        if (string.IsNullOrEmpty(mensaje))
        {
            mensaje = "Usuario registrado correctamente.";

            // Si el registro fue exitoso, se regresa al login
            Navigation.NavigateTo("/login");
        }
    }

    private void VolverLogin()
    {
        // Regresa al formulario de inicio de sesión sin registrar ningún usuario
        Navigation.NavigateTo("/login");
    }
}